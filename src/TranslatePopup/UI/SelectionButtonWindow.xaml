<Window x:Class="TranslatePopup.UI.SelectionButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="44" Height="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Button x:Name="TranslateButton"
            Width="44" Height="44"
            Padding="0"
            Cursor="Hand"
            PreviewMouseLeftButtonDown="TranslateButton_PreviewMouseLeftButtonDown"
            PreviewMouseLeftButtonUp="TranslateButton_PreviewMouseLeftButtonUp">
        <Button.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="22"/>
            </Style>
        </Button.Resources>
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="#2B7DE9" CornerRadius="12" x:Name="Bg">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="#1B3B6B"/>
                    </Border.Effect>
                    <TextBlock Text="訳" Foreground="White" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bg" Property="Background" Value="#1E5FBF"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
