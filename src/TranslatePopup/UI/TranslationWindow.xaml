<Window x:Class="TranslatePopup.UI.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="翻訳結果"
        Width="360" Height="260"
        MinWidth="220" MinHeight="140"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="White"
        Topmost="True"
        WindowStartupLocation="Manual">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#CCCCCC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar: language selector (top-left) and close button (top-right) -->
            <Grid Grid.Row="0" Background="#F3F3F3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="TargetLanguageComboBox"
                          Grid.Column="0"
                          Width="140"
                          Margin="6,4"
                          VerticalAlignment="Center"
                          DisplayMemberPath="Name"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"
                          SelectionChanged="TargetLanguageComboBox_SelectionChanged"/>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Width="36" Height="36"
                        Content="&#xD7;"
                        FontSize="16"
                        Background="Transparent"
                        BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Result area: fills remaining space and resizes with the window -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                <Grid>
                    <TextBlock x:Name="ResultTextBlock"
                               TextWrapping="Wrap"
                               FontSize="14"/>
                    <TextBlock x:Name="StatusTextBlock"
                               TextWrapping="Wrap"
                               Foreground="Gray"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
